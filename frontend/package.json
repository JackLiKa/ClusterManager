    "@types/node": "^24.0.10",
    "@types/sockjs-client": "^1.5.4",
    "@vitejs/plugin-vue": "^5.2.4",
    "@vue/eslint-config-prettier": "^10.1.0",
    "@vue/eslint-config-typescript": "^14.5.0",
    "eslint": "^9.24.0",
    "eslint-plugin-vue": "^10.1.0",
    "prettier": "^3.5.3",
